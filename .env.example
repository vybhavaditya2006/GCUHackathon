# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # safe in the browser (replaces the old "anon" key)
SUPABASE_SECRET_KEY=                    # server only (replaces the old "service_role" key)
GROQ_API_KEY=                           # server only
GROQ_MODEL=                             # a current chat model id from console.groq.com/docs/models, e.g. openai/gpt-oss-120b
